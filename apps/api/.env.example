PORT=3002
NODE_ENV=development

# Database
DATABASE_URL="postgresql://weopc:weopc123@localhost:5432/weopc?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS
CORS_ORIGIN=http://localhost:3003

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Search engine analysis
# Self-hosted OpenSERP base URL, for example http://127.0.0.1:7000
OPENSERP_BASE_URL=
# Optional when using OpenSERP Cloud; never expose this in the frontend
OPENSERP_API_KEY=
SEARCH_TIMEOUT_MS=8000
SEARCH_CACHE_TTL_MS=300000
SEARCH_DIRECT_FALLBACK=true
SEARCH_RATE_LIMIT_WINDOW_MS=900000
SEARCH_RATE_LIMIT_MAX_REQUESTS=30
